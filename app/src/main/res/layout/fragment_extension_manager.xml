<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:orientation="vertical">

    <!-- Status bar spacer driven dynamically by statusBars().top -->
    <View
        android:id="@+id/statusBarSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent" />

    <!-- Top Toolbar with AnymeX Capsule Style -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Left Capsule: Back + "Extensions" Title -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_capsule_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_back"
                android:padding="2dp"
                android:src="@drawable/ic_chevron_right"
                android:rotation="180"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/screenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/extensions_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Extension Testing Wrench Button -->
        <ImageButton
            android:id="@+id/buttonTesting"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_capsule_bar"
            android:contentDescription="@string/ext_testing_title"
            android:padding="11dp"
            android:src="@drawable/ic_wrench"
            app:tint="?attr/colorOnSurface" />

        <!-- Manage Repos Action (GitHub/Repo Icon) -->
        <ImageButton
            android:id="@+id/buttonManageRepos"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_capsule_bar"
            android:contentDescription="@string/extension_repos_title"
            android:padding="11dp"
            android:src="@drawable/ic_github"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- Category Pill Switcher: Anime vs Movie -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pill_container"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tabAnime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_accent_selected"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:text="@string/ext_category_anime_badge"
            android:textColor="#10131E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabMovie"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:text="@string/ext_category_movie_badge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Segmented Toggle: Installed vs Available -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill_container"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/toggleInstalled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_accent_selected"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/extensions_toggle_installed"
            android:textColor="#10131E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/toggleAvailable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/extensions_toggle_available"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search Input & Language Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="2dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="?attr/colorOnSurfaceVariant" />

        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/extensions_search_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:paddingVertical="10dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <!-- Language Filter Button (文A / translate icon) -->
        <ImageButton
            android:id="@+id/buttonLangFilter"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ext_filter_languages"
            android:padding="6dp"
            android:src="@drawable/ic_translate"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Engine Filter Chips Strip: All, Mangayomi, Aniyomi, Cloudstream, Sora -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- All Chip -->
            <TextView
                android:id="@+id/chipEngineAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_accent_selected"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="@string/ext_filter_all"
                android:textColor="#10131E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Mangayomi Chip -->
            <TextView
                android:id="@+id/chipEngineMangayomi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_capsule_bar"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="@string/ext_type_mangayomi"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Aniyomi Chip -->
            <TextView
                android:id="@+id/chipEngineAniyomi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_capsule_bar"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="@string/ext_type_aniyomi"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Cloudstream Chip -->
            <TextView
                android:id="@+id/chipEngineCloudstream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_capsule_bar"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="@string/ext_type_cloudstream"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Sora Chip -->
            <TextView
                android:id="@+id/chipEngineSora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_capsule_bar"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="@string/ext_type_sora"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Content Area with Pull-To-Refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Updates Pending Section -->
                <LinearLayout
                    android:id="@+id/updatesPendingContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Updates Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="18dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ext_updates_pending"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/buttonUpdateAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_update_all"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="6dp"
                            android:text="@string/ext_update_all"
                            android:textColor="#2B1214"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Updates Pending Items RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewUpdates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <!-- Reorder Subtitle -->
                    <TextView
                        android:id="@+id/reorderHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="18dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/ext_reorder_hint"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:textStyle="italic" />
                </LinearLayout>

                <!-- Main Extensions RecyclerView -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="200dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewExtensions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <!-- Empty View -->
                    <LinearLayout
                        android:id="@+id/emptyView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_layers"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/emptyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/extensions_empty_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/emptyBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/extensions_empty_body"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/loadingIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
