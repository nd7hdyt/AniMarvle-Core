<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_update"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="28dp">

    <!-- Subtle Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_capsule_active"
        android:backgroundTint="#26FFFFFF" />

    <!-- Header: Teal Squircle Icon + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_update_badge_squircle">

            <ImageView
                android:id="@+id/ivUpdateIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_system_update"
                app:tint="#31D7C6" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvUpdateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update available"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Version Subtitles -->
    <TextView
        android:id="@+id/tvNewVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#31D7C6"
        android:textSize="14.5sp"
        android:textStyle="bold"
        tools:text="Version 2.3.3" />

    <TextView
        android:id="@+id/tvCurrentVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#8E8E93"
        android:textSize="12.5sp"
        tools:text="You have v0.1.1 (build 2)." />

    <!-- Release Notes Header -->
    <TextView
        android:id="@+id/tvWhatsNewHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="What's new"
        android:textColor="#9E9EA6"
        android:textSize="13.5sp"
        android:textStyle="bold" />

    <!-- Release Notes Scroll Container -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollReleaseNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:maxHeight="220dp">

        <TextView
            android:id="@+id/tvReleaseNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5dp"
            android:textColor="#E0E0E6"
            android:textSize="13.5sp"
            tools:text="• Browse source catalogues directly from Home\n• Smoother transitions\n• Cleaner Sources screen" />
    </androidx.core.widget.NestedScrollView>

    <!-- Download Progress View (Gone initially) -->
    <LinearLayout
        android:id="@+id/llDownloadProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDownloadTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Downloading Update…"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDownloadPercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:text="Downloading the latest version: 0%"
            android:textColor="#8E8E93"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/pbDownload"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#2C2C34"
            android:progressTint="#31D7C6" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/llButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Skip"
            android:textColor="#8E8E93"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnLater"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Later"
            android:textColor="#FFFFFF"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdate"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:minWidth="110dp"
            android:paddingHorizontal="24dp"
            android:text="Update"
            android:textColor="#081A18"
            android:textSize="14.5sp"
            android:textStyle="bold"
            app:backgroundTint="#31D7C6"
            app:cornerRadius="23dp"
            app:elevation="0dp"
            app:rippleColor="#4D000000" />
    </LinearLayout>

</LinearLayout>
