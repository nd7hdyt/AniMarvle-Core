<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <!-- Bottom sheet handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_tab_indicator" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/my_list_add_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@color/surface_container" />

    <!-- Status Option Buttons matching th3-mylist-added screenshot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Watching -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWatching"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/my_list_status_watching"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_play_circle"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorPrimary" />

        <!-- Plan to Watch -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlanToWatch"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1.3"
            android:text="@string/my_list_status_plan_to_watch"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_calendar"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorPrimary" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- Completed -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompleted"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/my_list_status_completed"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorPrimary" />

        <!-- On-Hold -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOnHold"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/my_list_status_on_hold"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_pause"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorPrimary" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- Dropped -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDropped"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/my_list_status_dropped"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart"
            app:iconTint="#E53935" />

        <!-- Remove option if already in list -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemove"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:text="@string/my_list_remove"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
