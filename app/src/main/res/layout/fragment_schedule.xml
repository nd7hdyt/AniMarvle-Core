<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scheduleRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Status bar spacer driven dynamically by statusBars().top -->
    <View
        android:id="@+id/statusBarSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent" />

    <!-- Toolbar: [A] · Schedule · search icon -->
    <FrameLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/animarvle_logo_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_schedule"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/searchButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/details_search_episode"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            app:tint="#FFFFFF" />

        <!-- Top-Center Morphing Reload Indicator -->
        <com.animarvle.app.ui.player.VortexMorphLoadingView
            android:id="@+id/reloadIndicator"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Mode Tabs: Anime | Movies & TV -->
    <LinearLayout
        android:id="@+id/scheduleTabStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabAnime"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_display_mode_btn_selected"
            android:gravity="center"
            android:text="@string/tab_anime"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tabMoviesTv"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_display_mode_btn_unselected"
            android:gravity="center"
            android:text="@string/tab_movies_tv"
            android:textColor="#8E92A0"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/scheduleCountHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="2dp"
        android:textColor="#8E92A0"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Day strip: rounded tall pills, weekday over date -->
    <HorizontalScrollView
        android:id="@+id/dayStripScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/dayStrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

    </HorizontalScrollView>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="100dp" />

            <!-- Schedule Skeleton loading state (subtle pulsing list items) -->
            <LinearLayout
                android:id="@+id/scheduleSkeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="38dp"
                            android:layout_height="14dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="2dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/surface_variant" />

                    </LinearLayout>

                    <View
                        android:layout_width="104dp"
                        android:layout_height="68dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_skeleton_card" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="150dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_skeleton_rect" />

                        <View
                            android:layout_width="90dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="72dp"
                            android:layout_height="24dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_skeleton_pill" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="38dp"
                            android:layout_height="14dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="2dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/surface_variant" />

                    </LinearLayout>

                    <View
                        android:layout_width="104dp"
                        android:layout_height="68dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_skeleton_card" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="180dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_skeleton_rect" />

                        <View
                            android:layout_width="110dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="72dp"
                            android:layout_height="24dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_skeleton_pill" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="38dp"
                            android:layout_height="14dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="2dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/surface_variant" />

                    </LinearLayout>

                    <View
                        android:layout_width="104dp"
                        android:layout_height="68dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_skeleton_card" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="130dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_skeleton_rect" />

                        <View
                            android:layout_width="70dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="72dp"
                            android:layout_height="24dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_skeleton_pill" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="38dp"
                            android:layout_height="14dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="2dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/surface_variant" />

                    </LinearLayout>

                    <View
                        android:layout_width="104dp"
                        android:layout_height="68dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_skeleton_card" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="160dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_skeleton_rect" />

                        <View
                            android:layout_width="100dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="72dp"
                            android:layout_height="24dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_skeleton_pill" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/emptyBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/emptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_bg"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/emptyBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/on_bg_muted"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/action_retry"
                    android:visibility="gone" />

            </LinearLayout>

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>