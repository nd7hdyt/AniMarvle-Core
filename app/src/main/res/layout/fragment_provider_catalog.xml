<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/providerCatalogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Top Header Container (wraps status bar spacer + toolbar) -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Status Bar Spacer (dynamically sized to match status bar height) -->
        <View
            android:id="@+id/statusBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <!-- 56dp Toolbar Row with proper vertical centering -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF" />

            <!-- Dynamic Provider Name (e.g., "Crunchyroll") -->
            <TextView
                android:id="@+id/tvProviderName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Crunchyroll" />

            <!-- Sort / Filter Icon -->
            <ImageButton
                android:id="@+id/btnSort"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_tune"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Category Pill Row (Movies | Series | Anime) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <!-- Reusing the My List tiered navigation style -->
        <RadioGroup
            android:id="@+id/rgCategories"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/tabMovies"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/selector_pill_background"
                android:button="@null"
                android:checked="true"
                android:paddingHorizontal="20dp"
                android:text="Movies"
                android:textColor="@color/selector_pill_text"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/tabSeries"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@drawable/selector_pill_background"
                android:button="@null"
                android:paddingHorizontal="20dp"
                android:text="Series"
                android:textColor="@color/selector_pill_text"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/tabAnime"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@drawable/selector_pill_background"
                android:button="@null"
                android:paddingHorizontal="20dp"
                android:text="Anime"
                android:textColor="@color/selector_pill_text"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </RadioGroup>
    </HorizontalScrollView>

    <!-- Content Area: RecyclerView + Skeleton -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 3-Column Grid for Posters -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProviderCatalog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="90dp" />

        <!-- 3-Column Grid Skeleton Loading State -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/skeletonContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="90dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/skeletonContentLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Row 1 of 3 posters -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:background="@drawable/bg_skeleton_card" />

                        <View
                            android:layout_width="80dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="50dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:background="@drawable/bg_skeleton_card" />

                        <View
                            android:layout_width="72dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="45dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:background="@drawable/bg_skeleton_card" />

                        <View
                            android:layout_width="84dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="54dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2 of 3 posters -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:background="@drawable/bg_skeleton_card" />

                        <View
                            android:layout_width="76dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="48dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:background="@drawable/bg_skeleton_card" />

                        <View
                            android:layout_width="86dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="52dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:background="@drawable/bg_skeleton_card" />

                        <View
                            android:layout_width="70dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="44dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 3 of 3 posters -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:background="@drawable/bg_skeleton_card" />

                        <View
                            android:layout_width="82dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="52dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:background="@drawable/bg_skeleton_card" />

                        <View
                            android:layout_width="78dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="48dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:background="@drawable/bg_skeleton_card" />

                        <View
                            android:layout_width="88dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="56dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/bg_skeleton_pill" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

</LinearLayout>
