<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="36dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_bottom_sheet_drag_handle" />

    <!-- Sheet Title: Display (No Filter or Sort tabs) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:text="@string/my_list_display_title"
        android:textColor="@color/on_bg"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="20dp"
        android:background="@color/divider" />

    <!-- Section: Display mode -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="14dp"
        android:text="@string/my_list_display_mode"
        android:textColor="@color/on_bg"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Row 1: Compact grid & Comfortable grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCompactGrid"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_display_mode_btn_unselected"
            android:gravity="center"
            android:text="@string/my_list_display_compact_grid"
            android:textColor="@color/on_bg_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnComfortableGrid"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_display_mode_btn_selected"
            android:gravity="center"
            android:text="@string/my_list_display_comfortable_grid"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Row 2: Cover-only grid & List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCoverOnlyGrid"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_display_mode_btn_unselected"
            android:gravity="center"
            android:text="@string/my_list_display_cover_grid"
            android:textColor="@color/on_bg_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnList"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_display_mode_btn_unselected"
            android:gravity="center"
            android:text="@string/my_list_display_list"
            android:textColor="@color/on_bg_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Section: Items per row -->
    <LinearLayout
        android:id="@+id/itemsPerRowSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/my_list_display_items_per_row"
                android:textColor="@color/on_bg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/itemsPerRowValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="2"
                android:textColor="@color/on_bg_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Slider -->
        <com.google.android.material.slider.Slider
            android:id="@+id/itemsPerRowSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:stepSize="1.0"
            android:value="2.0"
            android:valueFrom="1.0"
            android:valueTo="5.0"
            app:thumbColor="?attr/colorPrimary"
            app:trackColorActive="?attr/colorPrimary"
            app:trackColorInactive="#33384D" />

    </LinearLayout>

</LinearLayout>
