<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@drawable/bg_vortex_row_ripple"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="24dp">

    <!-- AniVortex Leading Icon for root menu items (Playback Speed, Quality, Audio) -->
    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:visibility="gone"
        app:tint="#FFFFFF" />

    <!-- AniVortex Radio Circle (Left-aligned) for submenus -->
    <ImageView
        android:id="@+id/rowRadio"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_vortex_radio_unchecked" />

    <!-- Label / Title -->
    <TextView
        android:id="@+id/rowLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- Subtitle / Value on the right (e.g. "1.0x", "Auto", "Japanese") -->
    <TextView
        android:id="@+id/rowValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#B3FFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Chevron right for navigation -->
    <ImageView
        android:id="@+id/rowChevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone"
        app:tint="#80FFFFFF" />

    <!-- Legacy check view kept gone for compatibility -->
    <ImageView
        android:id="@+id/rowCheck"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>