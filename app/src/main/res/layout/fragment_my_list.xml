<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/myListRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Status bar spacer driven dynamically by statusBars().top -->
    <View
        android:id="@+id/statusBarSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent" />

    <!-- Top App Bar: Keeps Brand Icon + "My List" + Search + Stacked Filter Icon -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/brandLogo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/animarvle_logo_white"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/toolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/nav_my_list"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <!-- Search Icon -->
        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/schedule_search"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            app:tint="#FFFFFF" />

        <!-- Stacked Filter Icon -->
        <ImageButton
            android:id="@+id/btnStackedFilter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_display_options"
            android:padding="8dp"
            android:src="@drawable/ic_filter_list"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Optional Search Input Field (collapsible) -->
    <EditText
        android:id="@+id/searchEditText"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_chip_tonal"
        android:hint="@string/search_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/on_bg"
        android:textColorHint="@color/on_bg_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Row 1: Category Tabs (Movies | Series | Anime) -->
    <LinearLayout
        android:id="@+id/categoryTabRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tabMovies"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_mylist_pill_selected"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="Movies"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabSeries"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Series"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabAnime"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Anime"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 2: Status Tabs (Pending | Watching | Completed) -->
    <LinearLayout
        android:id="@+id/statusTabRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tabPending"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_mylist_pill_selected"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="Pending"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabWatching"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Watching"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabCompleted"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Completed"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtle 1dp Hairline Divider (Matches Images 2 & 3) -->
    <View
        android:id="@+id/tabHairlineDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#14FFFFFF" />

    <!-- Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 3-Column Poster Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/myListRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="11dp"
            android:paddingTop="14dp"
            android:paddingBottom="100dp" />

        <!-- Reference Empty State (Image 2: "No pending series") -->
        <LinearLayout
            android:id="@+id/emptyStateLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:visibility="gone">

            <!-- Outlined Bookmark Ribbon Icon -->
            <ImageView
                android:id="@+id/emptyBookmarkIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_bookmark_outline"
                app:tint="#616161" />

            <TextView
                android:id="@+id/emptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="No pending series"
                android:textColor="#FFFFFF"
                android:textSize="17.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/emptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Save titles from their details page to find them here."
                android:textColor="#757575"
                android:textSize="13.5sp" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
