<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_bottom"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_sheet_title"
                android:textColor="@color/on_bg"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/on_bg_muted"
                android:textSize="13sp"
                tools:text="Applies to this episode only · 14 choices available" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/player_close"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:tint="@color/on_bg_muted" />

    </LinearLayout>

    <!-- Language / server probe status row -->
    <LinearLayout
        android:id="@+id/statusLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <com.animarvle.app.ui.player.VortexMorphLoadingView
            android:id="@+id/progressChecking"
            android:layout_width="16dp"
            android:layout_height="16dp" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/server_checking_status"
            android:textColor="@color/on_bg_muted"
            android:textSize="12.5sp" />

    </LinearLayout>

    <!-- Category Segmented Tabs (All | Sub | Dub) -->
    <LinearLayout
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_segmented_container"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabAll"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segmented_item_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/server_tab_all"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabSub"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/player_tab_sub"
            android:textColor="@color/on_bg_muted"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabDub"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/player_tab_dub"
            android:textColor="@color/on_bg_muted"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Horizontal Language Filter Chips -->
    <HorizontalScrollView
        android:id="@+id/scrollLanguages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chipGroupLanguages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAny"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/server_lang_any"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipEnglish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/server_lang_english"
                android:textColor="@color/on_bg_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipHindi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/server_lang_hindi"
                android:textColor="@color/on_bg_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipArabic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/server_lang_arabic"
                android:textColor="@color/on_bg_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipSpanish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/server_lang_spanish"
                android:textColor="@color/on_bg_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipJapanese"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/server_lang_japanese"
                android:textColor="@color/on_bg_muted"
                android:textSize="13sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Server Cards Recycler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerServers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:maxHeight="420dp"
        android:nestedScrollingEnabled="true"
        tools:listitem="@layout/item_server_selection" />

    <!-- Empty view -->
    <TextView
        android:id="@+id/emptyServersView"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="@string/player_no_server_hint"
        android:textColor="@color/on_bg_muted"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
