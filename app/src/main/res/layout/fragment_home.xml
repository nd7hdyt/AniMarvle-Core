<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Scrollable content -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/homeScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Hero Banner: full-bleed art, gradient scrims, title, genres, Play + My List -->
                <FrameLayout
                    android:id="@+id/hero"
                    android:layout_width="match_parent"
                    android:layout_height="460dp">

                    <ImageView
                        android:id="@+id/heroImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <!-- Top scrim so header icons stay crisp over light artwork -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_gravity="top"
                        android:background="@drawable/bg_hero_scrim_top" />

                    <!-- Bottom scrim so hero text and buttons blend seamlessly into background -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="260dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_hero_scrim" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingBottom="24dp">

                        <TextView
                            android:id="@+id/heroTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:lineSpacingExtra="2dp"
                            android:maxLines="2"
                            android:textColor="@color/on_bg"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/heroGenres"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#B3FFFFFF"
                            android:textSize="13sp" />

                        <!-- Action buttons: Play + My List -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/heroPlay"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:backgroundTint="?attr/colorPrimary"
                                android:paddingStart="18dp"
                                android:paddingEnd="24dp"
                                android:text="@string/action_play"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:icon="@drawable/ic_play_circle"
                                app:iconTint="#FFFFFF"
                                app:iconPadding="8dp"
                                app:iconGravity="textStart"
                                app:cornerRadius="24dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/heroMyList"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/bg_hero_button_secondary"
                                android:paddingStart="18dp"
                                android:paddingEnd="22dp"
                                android:text="@string/schedule_add_my_list"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:icon="@drawable/ic_add"
                                app:iconTint="?attr/colorPrimary"
                                app:iconPadding="8dp"
                                app:iconGravity="textStart"
                                app:backgroundTint="@null"
                                app:cornerRadius="24dp" />

                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>


                <!-- State block: loading / error -->
                <LinearLayout
                    android:id="@+id/stateBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/stateTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/stateBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/stateRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/action_retry"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Rails are added here at runtime -->
                <LinearLayout
                    android:id="@+id/rails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="120dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Home Skeleton loading screen matching reference cold start -->
    <ScrollView
        android:id="@+id/skeletonContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:background="@color/bg"
        android:clipToPadding="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/skeletonContentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- Hero placeholder area (matching 460dp hero height) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="440dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/surface_container" />

                <!-- Bottom Scrim -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_hero_scrim" />

                <!-- Hero text + button placeholders -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="24dp">

                    <!-- Title placeholder bar -->
                    <View
                        android:layout_width="260dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_skeleton_rect" />

                    <!-- Genre placeholder bar -->
                    <View
                        android:layout_width="160dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_skeleton_pill" />

                    <!-- Buttons placeholder row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="100dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_skeleton_pill" />

                        <View
                            android:layout_width="110dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_skeleton_pill" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

            <!-- Rail section placeholder -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <!-- Section title pill -->
                <View
                    android:layout_width="140dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_skeleton_pill" />

                <!-- 2 Large Poster Cards matching reference -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <!-- Card 1 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="230dp"
                            android:background="@drawable/bg_skeleton_card" />

                        <View
                            android:layout_width="120dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_skeleton_pill" />

                    </LinearLayout>

                    <!-- Card 2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="230dp"
                            android:background="@drawable/bg_skeleton_card" />

                        <View
                            android:layout_width="110dp"
                            android:layout_height="12dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_skeleton_pill" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Offline / Unable to connect screen (AniVortex 1:1 matching Screenshot 2) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/offlineContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <!-- App Logo matching AV in reference: exactly centered at 51% of screen height -->
        <ImageView
            android:id="@+id/offlineLogo"
            android:layout_width="124dp"
            android:layout_height="120dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/animarvle_logo_white"
            android:scaleType="fitCenter"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.51" />

        <TextView
            android:id="@+id/offlineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/state_offline_title"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toTopOf="@+id/offlineBody"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/offlineBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:layout_marginBottom="26dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/state_offline_body"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@+id/offlineButtonsRow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Buttons: [Retry] [Downloads] matching AniVortex Screenshot 2 -->
        <LinearLayout
            android:id="@+id/offlineButtonsRow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="36dp"
            android:layout_marginBottom="62dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOfflineRetry"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/action_retry"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="14dp"
                app:strokeColor="#3A3A3C"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOfflineDownloads"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:backgroundTint="#FFFFFF"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/action_downloads"
                android:textColor="#000000"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Pinned Top Header: sits safely BELOW status bar spacer, matching Th3-Anime -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:orientation="vertical">

        <!-- Spacer matching status bar height, transparent at top of scroll -->
        <View
            android:id="@+id/statusBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@android:color/transparent" />

        <!-- App bar: Logo + Home · Search -->
        <FrameLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/appLogo"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/animarvle_logo_white" />

                <TextView
                    android:id="@+id/appName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_home"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/mediaToggleButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_mode_toggle"
                    android:padding="8dp"
                    android:src="@drawable/ic_mode_movie"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/searchButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_top_searches"
                    android:padding="8dp"
                    android:src="@drawable/ic_search"
                    app:tint="#FFFFFF" />

            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</FrameLayout>