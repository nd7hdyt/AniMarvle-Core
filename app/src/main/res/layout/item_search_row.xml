<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="9dp">

    <!-- Poster thumbnail (portrait 2:3 aspect ratio with 10dp rounded corners) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/thumb"
        android:layout_width="56dp"
        android:layout_height="80dp"
        app:cardBackgroundColor="#181818"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeColor="#262626"
        app:strokeWidth="0.5dp">

        <ImageView
            android:id="@+id/thumbImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Info column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            tools:text="Splice" />

        <!-- Sub metadata row: Type Pill · Year · ★ Score -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/typeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_search_format"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textColor="#A0A6B8"
                android:textSize="11sp"
                tools:text="Movie" />

            <TextView
                android:id="@+id/year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                tools:text="2010" />

            <LinearLayout
                android:id="@+id/scoreContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ "
                    android:textColor="#FFB800"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E1E4EC"
                    android:textSize="12sp"
                    tools:text="5.8" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Down chevron indicator matching AniVortex reference -->
    <ImageView
        android:id="@+id/chevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_down"
        app:tint="#8E8E93" />

</LinearLayout>