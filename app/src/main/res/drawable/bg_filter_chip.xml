<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#142824" />
            <stroke android:width="1.5dp" android:color="?attr/colorPrimary" />
            <corners android:radius="18dp" />
            <padding
                android:left="14dp"
                android:top="7dp"
                android:right="14dp"
                android:bottom="7dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#142824" />
            <stroke android:width="1.5dp" android:color="?attr/colorPrimary" />
            <corners android:radius="18dp" />
            <padding
                android:left="14dp"
                android:top="7dp"
                android:right="14dp"
                android:bottom="7dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#161B24" />
            <stroke android:width="1dp" android:color="#262E3D" />
            <corners android:radius="18dp" />
            <padding
                android:left="14dp"
                android:top="7dp"
                android:right="14dp"
                android:bottom="7dp" />
        </shape>
    </item>
</selector>
