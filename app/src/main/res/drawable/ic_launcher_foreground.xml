<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground. Android scales the foreground layer across the full
  108dp canvas and masks it to the launcher shape, so the 64x64 source art is
  inset by 18dp on every side and centred. That keeps the mark inside the
  guaranteed-visible inner area instead of being stretched edge to edge.
  The inset area is transparent, so the solid black background shows through
  and finishes the edges.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/ic_launcher_source"
        android:left="18dp"
        android:top="18dp"
        android:right="18dp"
        android:bottom="18dp" />
</layer-list>