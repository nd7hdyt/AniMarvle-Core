<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle top status-bar feather -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#A6000000"
                android:centerColor="#40000000"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>

    <!-- Curvy dark pocket radiating from top-left (Logo area) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.08"
                android:centerY="0.15"
                android:gradientRadius="140dp"
                android:startColor="#BF000000"
                android:centerColor="#59000000"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>

    <!-- Curvy dark pocket radiating from top-right (Search icon area) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.92"
                android:centerY="0.15"
                android:gradientRadius="140dp"
                android:startColor="#BF000000"
                android:centerColor="#59000000"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
